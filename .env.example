# ── Общее ──────────────────────────────────────────────────────────────────
# Разрешённые Telegram ID администраторов (comma-separated). Владелец: 727850088
ALLOWED_TELEGRAM_IDS=727850088

# Базовый URL сайта ForzaDJ (для публикации и колбэков статуса)
FORZADJ_API_URL=https://forzadj.ru

# ── Бот поддержки (@forza_sup_bot) ───────────────────────────────────────────
SUPPORT_BOT_TOKEN=
# Чат администратора для обращений (по умолчанию — первый из ALLOWED_TELEGRAM_IDS)
SUPPORT_ADMIN_CHAT_ID=727850088

# ── Бот модерации (@forzadj_creator_bot) ─────────────────────────────────────
MODERATION_BOT_TOKEN=
MODERATION_ADMIN_CHAT_ID=727850088
# Порт локального HTTP-ingest, куда сайт присылает заявки на модерацию
MODERATION_INGEST_PORT=8790
# Общий секрет для ingest (совпадает с сайтом)
MODERATION_INGEST_SECRET=
# Секрет /api/bot/upload на сайте (тот же, что BOT_UPLOAD_SECRET на сайте)
FORZADJ_BOT_SECRET=
# Секрет колбэка статуса на сайт /api/submissions/[id]/moderate
MODERATION_API_SECRET=
